{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "pre-commit": {
    "enabled": true
  },
  "schedule": [
    "before 6am on monday"
  ],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchManagers": [
        "github-actions",
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "ansible-core supports Python up to 3.14; ansible-lint and molecule crash on 3.15",
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "<3.15"
    }
  ],
  "customManagers": [
    {
      "description": "Molecule test images: one tag shared by all iamenr0s/docker-<distro>-ansible images",
      "customType": "regex",
      "managerFilePatterns": [
        "/^molecule/[^/]+/molecule\\.yml$/"
      ],
      "matchStrings": [
        "\\$\\{MOLECULE_IMAGE_TAG:-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\}"
      ],
      "depNameTemplate": "iamenr0s/docker-almalinux9-ansible",
      "datasourceTemplate": "docker"
    }
  ]
}
